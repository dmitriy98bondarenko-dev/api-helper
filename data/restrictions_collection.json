    {
      "name": "GetAndRechargeBalance",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "ctx._promises.push(\r",
              "    new Promise((resolve, reject) => {\r",
              "        try {\r",
              "            const walletId = pm.environment.get(\"walletId\");\r",
              "            const driverAuthToken = pm.environment.get(\"driverAuthToken\");\r",
              "            const adminAuthToken = pm.environment.get(\"adminAuthToken\");\r",
              "\r",
              "            const getUrl = pm.environment.get(\"driverGatewayHost\") \r",
              "                + \"/api/v1/wallets/\" + walletId + \"/balances\";\r",
              "\r",
              "            // GET balance\r",
              "            pm.sendRequest({\r",
              "                method: 'GET',\r",
              "                url: getUrl,\r",
              "                header: {\r",
              "                    \"Authorization\": \"Bearer \" + driverAuthToken,\r",
              "                    \"Content-Type\": \"application/json\"\r",
              "                }\r",
              "            }, function (error, res) {\r",
              "                if (error) {\r",

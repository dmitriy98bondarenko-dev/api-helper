  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          "eval(pm.globals.get(\"fetchAuthTokensFn\"));",
          "eval(pm.globals.get(\"decodeTockenAndSaveUserIdFn\"));",
          "",
          "let now = Math.floor(Date.now() / 1000);",
          "",
          "function needsRefresh(token, uidName) {",
          "    if (!token) {",
          "        console.warn(`Token ${uidName} is missing`);",
          "        return true;",
          "    }",
          "    try {",
          "        const decoded = decodeTockenAndSaveUserId({ token, uidName });",
          "        return decoded.exp < (now + 900); ",
          "    } catch (e) {",
          "        console.error(`Failed to decode token ${uidName}`, e);",
          "        return true;",
          "    }",
          "}",
          "",
          "const refreshList = [];",
          "",
          "if (needsRefresh(pm.collectionVariables.get(\"driverAuthToken\"), \"driverId\")) {",
          "    refreshList.push(fetchAuthTokens({",
          "        host: \"partnersIdentityHost\",",
          "        username: \"driverPhone\",",
          "        password: \"driverPassword\",",
          "        tokenName: \"driverAuthToken\"",
          "    }));",
          "}",
          "",
          "if (needsRefresh(pm.collectionVariables.get(\"adminAuthToken\"), \"adminId\")) {",
          "    refreshList.push(fetchAuthTokens({",
          "        host: \"internalIdentityHost\",",
          "        username: \"adminUsername\",",
          "        password: \"adminPassword\",",
          "        tokenName: \"adminAuthToken\"",
          "    }));",
          "}",
          "",
          "const p = Promise.all(refreshList)",
          "    .then(() => {",
          "        if (refreshList.length > 0) {",
          "            console.log(\"Tokens refreshed successfully\");",
          "        } else {",
          "            console.log(\"All tokens are still valid, refresh not needed\");",
          "        }",
          "        pm.collectionVariables.set(\"needAuth\", \"false\");",
          "    })",
          "    .catch(error => console.error(\"Error refreshing tokens\", error));",
          "",
          "ctx._promises.push(p);",
          ""
        ]
      }
    },

            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "ctx._promises.push(",
              "    new Promise((resolve, reject) => {",
              "        try {",
              "            // Поточний час у секундах",
              "            const now = Math.floor(Date.now() / 1000);",
              "",
              "            // Додати 7 днів (7 * 24 * 60 * 60 секунд)",
              "            const weekLater = now + (7 * 24 * 60 * 60);",
              "",
              "            // Зберігаємо у змінні колекції",
              "            pm.collectionVariables.set(\"actual_from\", now);",
              "            pm.collectionVariables.set(\"actual_till\", weekLater);",
              "",
              "            console.log(",
              "                \"This script for folder\\n\\tActual_from:\",",
              "                now,",
              "                \" actual_till:\",",
              "                weekLater",
              "            );",
              "",
              "            resolve(); // завершили проміс",
              "        } catch (err) {",
              "            reject(err);",
              "        }",
              "    })",
              ");",
              ""
            ]
          }
        },

    {
      "name": "GetAndDeleteAllRestrictions",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "ctx._promises.push(\r",
              "    new Promise((resolve, reject) => {\r",
              "        try {\r",
              "            const response = pm.response.json();\r",
              "            console.log(\"response is\", response);\r",
              "\r",
              "            const requests = response.items.map(item => {\r",
              "                return new Promise((res, rej) => {\r",
              "                    pm.sendRequest({\r",
              "                        method: \"DELETE\",\r",
              "                        url: pm.environment.get(\"partnersHost\")\r",
              "                            + \"/api/v1/fleets/\"\r",
              "                            + pm.environment.get(\"fleetId\")\r",
              "                            + \"/drivers/\"\r",
              "                            + pm.environment.get(\"driverId\")\r",
              "                            + \"/restrictions\",\r",
              "                        header: {\r",
              "                            \"Authorization\": \"Bearer \" + pm.environment.get(\"adminAuthToken\"),\r",
              "                            \"Content-Type\": \"application/json\"\r",
              "                        },\r",
              "                        body: {\r",
              "                            mode: 'raw',\r",
              "                            raw: JSON.stringify({\r",
              "                                \"type\": item.type,\r",
              "                            })\r",
              "                        }\r",
              "                    }, function (error, res) {\r",
              "                        if (error) {\r",
              "                            console.error(\"Error deleting restriction:\", item.type, error);\r",
              "                            rej(error);\r",
              "                        } else {\r",
              "                            console.log(\"Deleted restriction:\", item.type, \"→ status:\", res.code);\r",
              "                            res(); \r",
              "                        }\r",
              "                    });\r",
              "                });\r",
              "            });\r",
              "\r",
              "            Promise.all(requests).then(() => {\r",
              "                resolve();\r",
              "            }).catch(reject);\r",
              "\r",
              "        } catch (err) {\r",
              "            reject(err);\r",
              "        }\r",
              "    })\r",
              ");\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },

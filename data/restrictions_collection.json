    {
      "name": "GetAndChargeBalance",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "ctx._promises.push(\r",
              "    new Promise((resolve, reject) => {\r",
              "        try {\r",
              "            const walletId = pm.environment.get(\"walletId\");\r",
              "            const driverAuthToken = pm.environment.get(\"driverAuthToken\");\r",
              "            const adminAuthToken = pm.environment.get(\"adminAuthToken\");\r",
              "\r",
              "            const getUrl = pm.environment.get(\"driverGatewayHost\") \r",
              "                + \"/api/v1/wallets/\" + walletId + \"/balances\";\r",
              "\r",
              "            \r",
              "            pm.sendRequest({\r",
              "                method: 'GET',\r",
              "                url: getUrl,\r",
              "                header: {\r",
              "                    \"Authorization\": \"Bearer \" + driverAuthToken,\r",
              "                    \"Content-Type\": \"application/json\"\r",
              "                }\r",
              "            }, function (error, res) {\r",
              "                if (error) {\r",
              "                    console.error(\"Error fetching wallet balance:\", error);\r",
              "                    return reject(error);\r",
              "                }\r",
              "\r",
              "                try {\r",
              "                    const responseJson = res.json();\r",
              "                    console.log(\"Parsed response JSON:\", responseJson);\r",
              "\r",
              "                    let currentBalance = responseJson.amount;\r",
              "                    console.log(\"Current wallet amount:\", currentBalance);\r",
              "\r",
              "                    \r",
              "                    let chargeAmount = currentBalance + 100;\r",
              "\r",
              "                \r",
              "                    if (chargeAmount <= 0) {\r",
              "                        console.log(\"Charge amount <= 0, виставляємо мінімальний чардж 100\");\r",
              "                        chargeAmount = 100;\r",
              "                    }\r",
              "\r",
              "                    console.log(\"Charge amount:\", chargeAmount);\r",
              "\r",
              "                    const postUrl = pm.environment.get(\"adminGatewayHost\") \r",
              "                        + \"/api/v2/admin/finance/wallets/\" \r",
              "                        + walletId \r",
              "                        + \"/partner-payments/charge\";\r",
              "\r",
              "                \r",
              "                    pm.sendRequest({\r",
              "                        method: 'POST',\r",
              "                        url: postUrl,\r",
              "                        header: {\r",
              "                            \"Authorization\": \"Bearer \" + adminAuthToken,\r",
              "                            \"Content-Type\": \"application/json\"\r",
              "                        },\r",
              "                        body: {\r",
              "                            mode: 'raw',\r",
              "                            raw: JSON.stringify({\r",
              "                                \"amount\": chargeAmount,\r",
              "                                \"description\": \"Test\",\r",
              "                                \"initiated_by_user_id\": \"f05a3650d531497eadd1c3badd0c4370\",\r",
              "                                \"profit_loss_type\": \"driver_penalty_order_other\",\r",
              "                                \"region_id\": 1,\r",
              "                                \"vb_type\": \"cash_order_fee\"\r",
              "                            })\r",
              "                        }\r",
              "                    }, function (error, res) {\r",
              "                        if (error) {\r",
              "                            console.error(\"Error while charging:\", error);\r",
              "                            return reject(error);\r",
              "                        }\r",
              "\r",
              "                        console.log(\"Charge response status:\", res.code);\r",
              "                        console.log(\"Charge response body:\", res.body);\r",
              "\r",
              "                        resolve(); \r",
              "                    });\r",
              "\r",
              "                } catch (err) {\r",
              "                    console.error(\"Failed to parse response:\", err);\r",
              "                    reject(err);\r",
              "                }\r",
              "            });\r",
              "\r",
              "        } catch (err) {\r",
              "            reject(err);\r",
              "        }\r",
              "    })\r",
              ");\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },

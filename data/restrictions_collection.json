              "                            })\r",
              "                        }\r",
              "                    }, function (error, res) {\r",
              "                        if (error) {\r",
              "                            console.error(\"Error while recharging:\", error);\r",
              "                            return reject(error);\r",
              "                        }\r",
              "\r",
              "                        console.log(\"Recharge response status:\", res.code);\r",
              "                        console.log(\"Recharge response body:\", res.body);\r",
              "\r",
              "                        resolve(); \r",
              "                    });\r",
              "\r",
              "                } catch (err) {\r",
